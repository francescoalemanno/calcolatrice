# Maintainer: Francesco Alemanno <francescoalemanno710@gmail.com>

pkgname=calcolatrice
pkgver=0.2.0
pkgrel=1
pkgdesc='Calcolatrice scientifica con formule e grafici delle variabili libere'
arch=('x86_64' 'aarch64')
url='https://github.com/francescoalemanno/calcolatrice'
license=('MIT')
# winit e glow caricano X11/Wayland/OpenGL a runtime con dlopen
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon'
         'libx11' 'libxcursor' 'libxi' 'libxrandr' 'wayland')
makedepends=('cargo')
optdepends=("noto-fonts: carattere dell'interfaccia (altrimenti quello integrato)"
            'ttf-dejavu: simboli matematici aggiuntivi')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('959581d4c242d3a904d8da1162d417ac025880ab526140f70df5035ca0560b01')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/$pkgname -t "$pkgdir/usr/bin"
  install -Dm644 assets/$pkgname.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 assets/$pkgname.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 assets/icons/${size}x${size}/$pkgname.png \
      -t "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
  done
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
